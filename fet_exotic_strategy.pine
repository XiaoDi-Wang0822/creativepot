// @version=5
strategy("FET Kinetic Trend-RSI Strategy", overlay=true, initial_capital=100, default_qty_type=strategy.percent_of_equity, default_qty_value=300, commission_type=strategy.commission.percent, commission_value=0.06, slippage=3, currency=currency.USD)

// --- Parameters ---
ma_fast_len = input.int(50, "Trend Filter Fast (Velocity)")
ma_slow_len = input.int(200, "Trend Filter Slow (Baseline)")
rsi_len = input.int(14, "Kinetic Oscillator Period")
rsi_long_entry = input.int(33, "Long Entry Threshold")
rsi_short_entry = input.int(67, "Short Entry Threshold")
rsi_long_exit = input.int(60, "Long Exit Threshold")
rsi_short_exit = input.int(40, "Short Exit Threshold")
// Leverage is 3x, so a 4.5% equity loss means a 1.5% price movement against the position.
stop_loss_pct = input.float(4.5, "Leveraged MaxDD Protection (%)")

// --- Indicators ---
// We use EMA to capture price velocity with less lag than SMA
ma_fast = ta.ema(close, ma_fast_len)
ma_slow = ta.ema(close, ma_slow_len)
// RSI acts as our Kinetic Oscillator to time entries during pullbacks in a trend
rsi = ta.rsi(close, rsi_len)

// --- Signal Logic ---
long_condition = ma_fast > ma_slow and rsi < rsi_long_entry
short_condition = ma_fast < ma_slow and rsi > rsi_short_entry

// --- Execution ---
// Sizing is automatically 300% of equity (3x leverage) per strategy settings
if (long_condition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long, comment="Kinetic Long")

if (short_condition and strategy.position_size == 0)
    strategy.entry("Short", strategy.short, comment="Kinetic Short")

// --- Risk Management & Exit Logic ---
// We calculate the hard stop price based on the avg entry price to protect the 35% MaxDD constraint.
float long_sl = strategy.position_avg_price * (1 - (stop_loss_pct / 100) / 3)
float short_sl = strategy.position_avg_price * (1 + (stop_loss_pct / 100) / 3)

if strategy.position_size > 0
    if rsi > rsi_long_exit
        strategy.close("Long", comment="TP Target")
    strategy.exit("Exit Long", "Long", stop=long_sl, comment="Hard SL")

if strategy.position_size < 0
    if rsi < rsi_short_exit
        strategy.close("Short", comment="TP Target")
    strategy.exit("Exit Short", "Short", stop=short_sl, comment="Hard SL")

// --- Visuals ---
plot(ma_fast, color=color.new(color.aqua, 0), title="Velocity EMA")
plot(ma_slow, color=color.new(color.gray, 0), title="Baseline EMA")
plotshape(long_condition, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(short_condition, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
