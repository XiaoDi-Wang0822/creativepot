// @version=5
strategy("FET Kinetic Alpha Scalp (MaxDD < 35%)", overlay=true, initial_capital=100, default_qty_type=strategy.percent_of_equity, default_qty_value=300, commission_type=strategy.commission.percent, commission_value=0.06, slippage=3, currency=currency.USD, margin_long=33.3, margin_short=33.3)

// --- Strategy Inputs ---
trend_fast = input.int(20, "Trend Filter Fast")
trend_slow = input.int(100, "Trend Filter Slow")
rsi_period = input.int(7, "Kinetic Momentum Period")
rsi_en_l = input.int(20, "Long Entry RSI")
rsi_en_h = input.int(80, "Short Entry RSI")
rsi_ex_h = input.int(75, "Long Exit RSI")
rsi_ex_l = input.int(25, "Short Exit RSI")
// 1.2% price move = 3.6% equity loss at 3x leverage.
sl_pct = input.float(1.2, "Price Stop Loss (%)", step=0.1)

// --- 1. Exotic Logic: Price Acceleration (2nd Derivative) ---
// We use a custom EMA-smoothed difference to identify "Kinetic Bursts"
v = ta.ema(close - close[3], 5)
a = ta.ema(v - v[3], 5)

// --- 2. Trend & Timing Filters ---
ma_f = ta.sma(close, trend_fast)
ma_s = ta.sma(close, trend_slow)
rsi = ta.rsi(close, rsi_period)

// --- 3. Entry Signal Logic ---
// We combine Trend direction, RSI exhaustion, and Price Acceleration
long_signal = ma_f > ma_s and rsi < rsi_en_l and a > 0
short_signal = ma_f < ma_s and rsi > rsi_en_h and a < 0

if (long_signal and strategy.position_size == 0)
    strategy.entry("Long", strategy.long, comment="Kinetic Entry")

if (short_signal and strategy.position_size == 0)
    strategy.entry("Short", strategy.short, comment="Kinetic Entry")

// --- 4. Dynamic Exit & Risk Management ---
// Hard Stop Loss calculation
long_sl = strategy.position_avg_price * (1 - sl_pct / 100)
short_sl = strategy.position_avg_price * (1 + sl_pct / 100)

if strategy.position_size > 0
    if rsi > rsi_ex_h
        strategy.close("Long", comment="RSI Target")
    strategy.exit("SL Long", "Long", stop=long_sl, comment="Hard SL")

if strategy.position_size < 0
    if rsi < rsi_ex_l
        strategy.close("Short", comment="RSI Target")
    strategy.exit("SL Short", "Short", stop=short_sl, comment="Hard SL")

// --- Visuals ---
plot(ma_f, color=color.new(color.aqua, 0), title="Trend Fast")
plot(ma_s, color=color.new(color.orange, 0), title="Trend Slow")
plotshape(long_signal, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(short_signal, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
